# ReelLink desktop app: optional overrides.
# None of these are needed for normal use. The owner account is hardcoded in
# src/config/index.js (OWNER_USERNAME).

# Browser Playwright drives: msedge (default, ships with Windows) or chrome
IG_BROWSER_CHANNEL=msedge
# Run the browser hidden during batches (Instagram can behave worse headless)
IG_HEADLESS=false
# Simulate follows/comments without posting anything (same as `npm run start:sim`)
REELLINK_SIMULATION=false
# Max retries per Reel before it is marked FAILED
JOB_MAX_RETRIES=3
LOG_LEVEL=info
