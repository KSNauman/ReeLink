# ==========================================
# ReelLink Configuration Environment Variables
# ==========================================

# ------------------------------------------
# 1. Instagram Bot Account & Session
# ------------------------------------------
# Dedicated Instagram account used by the bot to receive Reels and send replies
IG_USERNAME=your_bot_username
IG_PASSWORD=your_bot_password
# Persistent browser profile path (stores cookies and storage state to prevent repetitive logins)
IG_PROFILE_DIR=./data/browser_profile
IG_HEADLESS=false
# Polling interval in seconds for inbox checks (default 15s)
IG_POLL_INTERVAL_SEC=15
# Dry-run mode: logs simulated actions without sending actual DMs or comments
DRY_RUN=true
# Supervised mode: requires terminal confirmation before sending DMs
SUPERVISED_MODE=false
# Optional: Allowed user usernames or thread IDs (comma-separated). If blank, responds to all shared Reels.
IG_ALLOWED_USERS=

# ------------------------------------------
# 2. Database & Storage Configuration
# ------------------------------------------
DATABASE_PATH=./data/reellink.db
MEDIA_STORAGE_DIR=./data/media
LOG_LEVEL=info

# ------------------------------------------
# 3. Pipeline & Content Extraction
# ------------------------------------------
# Frame extraction interval in seconds (default 2s = 1 frame every 2 seconds)
OCR_SAMPLE_INTERVAL_SEC=2
# Max frames to extract for OCR per Reel
OCR_MAX_FRAMES=30
# Path to Tesseract binary (if not in PATH on Windows, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_PATH=tesseract
# Path to FFmpeg binary (if not in PATH, e.g. C:\tools\ffmpeg\bin\ffmpeg.exe)
FFMPEG_PATH=ffmpeg

# ------------------------------------------
# 4. Audio Transcription (faster-whisper)
# ------------------------------------------
# Whisper model size: tiny, base, small, medium, large-v3 (recommend tiny or base for fast local execution)
WHISPER_MODEL=base
# Whisper device: cpu, cuda, or auto
WHISPER_DEVICE=auto
# Python executable for transcription worker
PYTHON_PATH=python

# ------------------------------------------
# 5. Search Adapter Configuration
# ------------------------------------------
# Search provider: ddg (DuckDuckGo public/html), google_pse, serpapi, tavily, brave
SEARCH_PROVIDER=ddg
SEARCH_MAX_RESULTS=5
SEARCH_CONFIDENCE_THRESHOLD=0.65

# Optional API Keys (if using commercial search providers)
SERPAPI_API_KEY=
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ------------------------------------------
# 6. Creator Workflow & Safety Guardrails
# ------------------------------------------
# Require explicit user approval before commenting or following creators (true/false)
CREATOR_WORKFLOW_REQUIRE_APPROVAL=true
# Timeout in seconds to wait for creator automated DM response (default 180s)
CREATOR_WORKFLOW_TIMEOUT_SEC=180
# Maximum retry attempts per job
JOB_MAX_RETRIES=3
