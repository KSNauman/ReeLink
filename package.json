{
  "name": "reellink",
  "version": "0.1.0",
  "description": "Autonomous Instagram Reel Resource Discovery Bot",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dashboard": "node src/app.js --live --auto-approve",
    "start:live": "node src/app.js --live",
    "start:auto": "node src/app.js --live --auto-approve",
    "approve": "node src/approve.js",
    "dev": "node --watch src/app.js",
    "setup:session": "node src/instagram/setup-session.js",
    "test": "node --test tests/unit/*.js tests/integration/*.js tests/e2e/*.js",
    "test:unit": "node --test tests/unit/*.js",
    "test:integration": "node --test tests/integration/*.js",
    "test:e2e": "node --test tests/e2e/*.js",
    "test:supervised": "node tests/live-test-supervised.js",
    "test:creator:supervised": "node tests/test-creator-supervised-live.js",
    "test:benchmark": "node tests/benchmark-runner.js",
    "clean:browser": "powershell -Command \"Stop-Process -Name chrome, chromium -Force -ErrorAction SilentlyContinue; Remove-Item -Path 'data/browser_profile/SingletonLock' -Force -ErrorAction SilentlyContinue\"",
    "start:clean": "npm run clean:browser && npm run start:auto"
  },
  "keywords": [
    "instagram",
    "reels",
    "automation",
    "playwright",
    "sqlite",
    "ocr",
    "whisper"
  ],
  "author": "ReelLink Team",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.50.0",
    "tesseract.js": "^7.0.0"
  }
}
