# ==========================================
# ReelLink .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.cert
credentials.json
session.json
secrets.json

# ------------------------------------------
# Browser & Automation Profiles (Playwright / Chromium)
# ------------------------------------------
data/browser_profile/
data/sessions/
browser_profile/
storage_state.json
playwright/.cache/
.playwright/
SingletonLock
SingletonCookie
SingletonSocket

# ------------------------------------------
# Database & SQLite Files
# ------------------------------------------
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite3
data/*.csv
data/reellink.db*
*.db
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------
# Media & Temporary Processing Assets
# ------------------------------------------
data/downloads/
data/frames/
data/audio/
data/temp/
temp/
downloads/
*.mp4
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.pdf

# OCR Language & Model Binaries (Tesseract)
*.traineddata

# ------------------------------------------
# Scratch & Development Testing Scripts
# ------------------------------------------
scratch/

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/

# ------------------------------------------
# Logs, Debugging & Test Coverage
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
coverage/
.nyc_output/

# ------------------------------------------
# Editor & IDE Configs
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# Operating System Artifacts
# ------------------------------------------
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
*.tmp
*.temp
*.bak
